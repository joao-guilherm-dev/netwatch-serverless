{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "lib": ["ES2022"], "rootDir": ".", "outDir": ".dist",
    "strict": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noImplicitOverride": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"], "exclude": ["node_modules", ".dist"]
}